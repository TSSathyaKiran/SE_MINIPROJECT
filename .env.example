# Copy to .env and fill in both keys; the app refuses to start without them.
# .env is never committed. Running the app without them prints ready-made lines to paste.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Leave DATABASE_URL unset to use the built-in SQLite file (src/instance/srs.db).
# For MySQL:  DATABASE_URL=mysql+pymysql://root:password@localhost/srs_app
# DATABASE_URL=

# Encrypts student email, phone and address (SRS-SR-004). Keep a copy somewhere safe:
# without it the encrypted data cannot be read. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_KEY=
