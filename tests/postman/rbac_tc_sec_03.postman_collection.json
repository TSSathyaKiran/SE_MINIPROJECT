{
  "info": {
    "name": "SRS-App RBAC checks (TC-Sec-03)",
    "description": "Logs in as a student and checks that admin and faculty routes return 403, that anonymous calls return 401, and that student-allowed routes work. Run it with the app started (python src/seed.py && python src/run.py). A 404 means that route's issue has not been merged yet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Not logged in (expect 401)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Postman keeps cookies; remove the login cookie so these calls are truly anonymous",
              "pm.cookies.jar().clear(pm.variables.replaceIn(\"{{baseUrl}}\"), function () {});"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "POST /terms without login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
